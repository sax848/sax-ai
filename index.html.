<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SAX AI - Your AI Universe</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#090911;color:white;font-family:Arial,sans-serif}
.app{display:flex;min-height:100vh}
.sidebar{width:245px;background:#10101b;border-right:1px solid #252536;padding:24px 16px;flex-shrink:0}
.logo{font-size:27px;font-weight:900;color:#a78bfa;margin-bottom:35px}
.logo span{color:#fff}
.new{width:100%;padding:13px;border:1px solid #51417c;background:#211a36;color:white;border-radius:10px;cursor:pointer}
.menu{margin-top:28px}
.menu p{font-size:11px;color:#77778e;letter-spacing:2px}
.tool{padding:12px;border-radius:9px;margin:5px 0;color:#c7c5d5;cursor:pointer}
.tool:hover,.tool.active{background:#28213e;color:white}
.main{flex:1;padding:30px;min-width:0}
.top{display:flex;justify-content:space-between;align-items:center}
.tag{color:#a78bfa;font-size:12px}
h1{font-size:34px;margin:35px 0 8px}
.sub{color:#9999ac}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:30px}
.card{background:#141421;border:1px solid #29293b;border-radius:15px;padding:19px;cursor:pointer;transition:.2s}
.card:hover{border-color:#9872ef;transform:translateY(-3px)}
.card .emoji{font-size:27px}
.card h3{margin:14px 0 7px}
.card p{font-size:13px;color:#9999ac;line-height:1.5}
.chat{margin-top:30px;background:#141421;border:1px solid #29293b;border-radius:16px;padding:20px}
.chat h2{font-size:19px}
.messages{min-height:130px;max-height:300px;overflow:auto;color:#ddd;line-height:1.6}
.msg{padding:11px;margin:8px 0;border-radius:10px;background:#211d31}
.input{display:flex;gap:9px;margin-top:15px}
input{min-width:0;flex:1;background:#0d0d17;border:1px solid #353548;padding:14px;border-radius:10px;color:white;outline:none}
button.send{background:#8056dc;color:white;border:0;border-radius:10px;padding:12px 20px;cursor:pointer}
.status{color:#8c8ca2;font-size:12px;margin-top:12px}
@media(max-width:750px){
.sidebar{width:75px;padding:15px 8px}
.logo{font-size:19px;text-align:center}
.logo span,.tool span,.menu p{display:none}
.new{font-size:0;padding:12px}
.new:after{content:"+";font-size:20px}
.tool{text-align:center;font-size:20px}
.main{padding:18px 12px}
h1{font-size:27px}
.cards{grid-template-columns:repeat(2,1fr)}
.card{padding:12px}
}
@media(max-width:420px){.cards{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="app">
<aside class="sidebar">
<div class="logo">SAX<span> AI</span></div>
<button class="new" onclick="newChat()">＋ New Chat</button>
<div class="menu">
<p>YOUR WORKSPACE</p>
<div class="tool active" onclick="selectTool(this,'Chat')">💬 <span>AI Chat</span></div>
<div class="tool" onclick="selectTool(this,'Images')">🎨 <span>AI Images</span></div>
<div class="tool" onclick="selectTool(this,'Video')">🎬 <span>AI Video</span></div>
<div class="tool" onclick="selectTool(this,'Presentations')">📊 <span>Presentations</span></div>
<div class="tool" onclick="selectTool(this,'Voice')">🎙️ <span>AI Voice</span></div>
<div class="tool" onclick="selectTool(this,'Code')">💻 <span>AI Code</span></div>
</div>
</aside>

<main class="main">
<div class="top">
<div class="tag">✦ YOUR AI UNIVERSE</div>
<div class="tag">● SAX AI 1.0</div>
</div>

<h1 id="heading">Welcome to SAX AI ✨</h1>
<p class="sub" id="description">Everything you need, powered by artificial intelligence.</p>

<div class="cards">
<div class="card" onclick="selectToolByName('Chat')">
<div class="emoji">💬</div><h3>AI Chat</h3>
<p>Ask anything. Get intelligent answers.</p>
</div>
<div class="card" onclick="selectToolByName('Images')">
<div class="emoji">🎨</div><h3>AI Images</h3>
<p>Turn your ideas into images.</p>
</div>
<div class="card" onclick="selectToolByName('Video')">
<div class="emoji">🎬</div><h3>AI Video</h3>
<p>Create videos from your ideas.</p>
</div>
<div class="card" onclick="selectToolByName('Presentations')">
<div class="emoji">📊</div><h3>Presentations</h3>
<p>Create beautiful presentations.</p>
</div>
<div class="card" onclick="selectToolByName('Voice')">
<div class="emoji">🎙️</div><h3>AI Voice</h3>
<p>Explore audio and voice tools.</p>
</div>
<div class="card" onclick="selectToolByName('Code')">
<div class="emoji">💻</div><h3>AI Code</h3>
<p>Build apps and write code.</p>
</div>
</div>

<div class="chat">
<h2 id="chatTitle">💬 SAX AI Assistant</h2>
<div class="messages" id="messages">
<div class="msg">Ciao! Sono SAX AI. 👋<br>Benvenuto nella tua nuova piattaforma AI!</div>
</div>
<div class="input">
<input id="prompt" placeholder="Ask SAX AI anything..." onkeydown="if(event.key==='Enter')sendMessage()">
<button class="send" onclick="sendMessage()">Send ➤</button>
</div>
<div class="status">✦ Demo mode · AI connection coming soon</div>
</div>
</main>
</div>

<script>
let currentTool="Chat";
function selectTool(el,name){
document.querySelectorAll(".tool").forEach(x=>x.classList.remove("active"));
if(el)el.classList.add("active");
currentTool=name;
document.getElementById("chatTitle").innerText="✦ SAX "+name;
document.getElementById("heading").innerText="SAX "+name;
document.getElementById("description").innerText="Explore your "+name+" workspace.";
document.getElementById("prompt").placeholder="Write something for SAX "+name+"...";
}
function selectToolByName(name){
let el=[...document.querySelectorAll(".tool")].find(x=>x.innerText.includes(name));
selectTool(el,name);
}
function newChat(){
document.getElementById("messages").innerHTML='<div class="msg">Nuova conversazione! Come posso aiutarti?</div>';
}
function sendMessage(){
let input=document.getElementById("prompt");
let value=input.value.trim();
if(!value)return;
let messages=document.getElementById("messages");
messages.innerHTML+='<div class="msg"><b>You:</b> '+escapeHTML(value)+'</div>';
messages.innerHTML+='<div class="msg"><b>SAX AI:</b> Questa è una versione dimostrativa. Il collegamento al modello AI verrà aggiunto nella prossima fase! 🚀</div>';
input.value="";
messages.scrollTop=messages.scrollHeight;
}
function escapeHTML(s){
return s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
</script>
</body>
</html>
